# Function expressions: parameter attributes render after the parameter
# value, and a trailing "..." marks an open signature. A parameter list
# with doc comments breaks into a table with the "..." on its own row. A
# call whose argument list ends in "..." is a partial application.
-- in --
@experiment(functions)

tagged: func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b

open:      func(a: int, ...) -> number
openOnly:  func(...) -> int
openMulti: func(
	// first operand
	a: int,
	b?: string,
	...
) -> int

partialLabel: add(a: 1, ...)
partialPos:   add(1, ...)
partialNone:  add(...)
partialMany:  add(1, 2, ...)
-- out/relpos --
@experiment(functions)

tagged: func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b

open:     func(a: int, ...) -> number
openOnly: func(...) -> int
openMulti: func(
	// first operand
	a: int,
	b?: string,
	...
) -> int

partialLabel: add(a: 1, ...)
partialPos:   add(1, ...)
partialNone:  add(...)
partialMany:  add(1, 2, ...)
-- out/norelpos --
@experiment(functions)
tagged:   func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b
open:     func(a: int, ...) -> number
openOnly: func(...) -> int
openMulti: func(
	// first operand
	a: int,
	b?: string,
	...
) -> int
partialLabel: add(a: 1, ...)
partialPos:   add(1, ...)
partialNone:  add(...)
partialMany:  add(1, 2, ...)
