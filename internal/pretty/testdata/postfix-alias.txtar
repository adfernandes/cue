# Exercises the postfixAlias converter for both forms: the simple
# `label~X` and the dual `label~(K,V)`. The @experiment(aliasv2)
# attribute is redundant as of language version v0.18.0, where the
# experiment is stable, and doubles as a top-level attribute to print.
-- in --
@experiment(aliasv2)
#Simple: {
	x~X: int
}
#Dual: {
	x~(K, V): int
}
-- out/relpos --
@experiment(aliasv2)
#Simple: {
	x~(X): int
}
#Dual: {
	x~(K,V): int
}
-- out/norelpos --
@experiment(aliasv2), #Simple: {x~(X): int}, #Dual: {x~(K,V): int}
