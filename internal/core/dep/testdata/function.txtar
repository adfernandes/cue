-- in.cue --
@experiment(functions)

import "strconv"

// Dependencies inside function literals: parameter constraints, the return
// type, and the body are all expressions that may reference outer features.
a: {
	b: fn(2)
	fn: func(x: T) -> R: x + offset + strconv.Atoi(str)

	// A function literal in an inline call: the literal itself occurs in the
	// conjuncts of the field.
	c: (func(x: int) -> int: x + offset)(1)

	// Selecting into a call result reaches the inline result vertex, whose
	// conjunct is the call reference carrying the function's expressions.
	mk: func(x: int) -> {out: int}: {out: x + offset}
	d: mk(1).out
}

T: int
R: int
offset: 3
str: "5"
-- out/dependencies/field --
line  reference    path of resulting vertex
8:    fn        => a.fn
-- out/dependencies/all --
line  reference       path of resulting vertex
9:    T            => T
9:    R            => R
9:    offset       => offset
9:    strconv.Atoi => "strconv".Atoi
9:    str          => str
13:   offset       => offset
17:   offset       => offset
-- out/dependencies/dynamic --
line  reference       path of resulting vertex
8:    fn           => a.fn
9:    T            => T
9:    R            => R
9:    offset       => offset
9:    strconv.Atoi => "strconv".Atoi
9:    str          => str
13:   offset       => offset
17:   x            => **non-rooted**
17:   offset       => offset
-- out/dependencies-v3/stats/field --
// COUNT: 1
-- out/dependencies-v3/stats/all --
// COUNT: 14
-- out/dependencies-v3/stats/dynamic --
// COUNT: 26
