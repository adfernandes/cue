#path: result

#Issue: 2944
# The old prefix alias syntax (X=) is only accepted below v0.18.0, where
# @experiment(aliasv2) is stable; pin the language version so
# that this test keeps exercising it.
-- cue.mod/module.cue --
module: "test.example"
language: version: "v0.17.0"
-- in.cue --
#Test: {
	name: string
	tests: [...#Test]
}

#Resolver: {
	parent?:   #Test
	self=test: #Test

	resolved: {
		if parent == _|_ {
			name: test.name
		}
		if parent != _|_ {
			name: "\(parent.name) / \(test.name)"
		}

		tests: [
			for t in test.tests {
				(#Resolver & {
					parent: self
					test:   t
				}).resolved
			},
		]
	}
}

let root = #Test & {
	name: "Smoke Tests"
	tests: [{name: "Inner"}]
}

result: (#Resolver & {
	parent: _
	test: root
}).resolved
