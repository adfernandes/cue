#path: a.b

-- in.cue --
ext~(E): one:       1
("ext1")~(E1): two: 2
("ext2")~(E2): {three: 3, a: int}
a: b~(B): {
	x: string
	y: B.x

	// TODO: use with non-concrete value. Right now, this causes the reference
	// above to not shorten (it will point to b, instead of x, as x won't be
	// reachable).
	// Reevaluated after value aliases for embeddings are implemented.
	z:         "string"
	(z)~(X):   4
	("y")~(Y): "foo"
	enclosed: {
		x~(V): string
		y:     B.enclosed.x
		z:     V

		// Comment.
		labelX: X
		labelY: Y
	}
	hoisted: {
		"ext1": E
		ext2:   E
		ext3:   E1
		ext4:   E2
		ext5:   E2.a
	}

	other: [string]~(INNER,_): name: INNER
}

[string]~(NAME,_): b: name: NAME
-- out/self/default --
{
	x: string
	y: x

	// TODO: use with non-concrete value. Right now, this causes the reference
	// above to not shorten (it will point to b, instead of x, as x won't be
	// reachable).
	// Reevaluated after value aliases for embeddings are implemented.
	z:       "string"
	(z)~(X): 4
	"y"~(Y): "foo"
	enclosed: {
		x~(V): string
		y:     enclosed.x
		z:     V

		// Comment.
		labelX: X
		labelY: Y
	}
	hoisted: {
		ext1: EXT
		ext2: EXT
		ext3: {
			two: 2
			b: name: "ext1"
		}
		ext4: EXT2
		ext5: EXT2.a
	}
	other: [string]~(INNER,_): name: INNER
}
name: "a"

//cue:path: ext
let EXT = {
	one: 1
	b: name: "ext"
}

//cue:path: ext2
let EXT2 = {
	three: 3
	b: name: "ext2"
	a: int
}
