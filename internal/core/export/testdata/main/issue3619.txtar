# The old prefix alias syntax (X=) is only accepted below v0.18.0, where
# @experiment(aliasv2) is stable; pin the language version so
# that this test keeps exercising it.
-- cue.mod/module.cue --
module: "test.example"
language: version: "v0.17.0"
-- in.cue --
outputs: [Name=string]: metadata: {
	name: "\(Name)"
	labels: string
}
outputs: "test": metadata: labels: "test-label"
-- out/definition-v3 --
outputs: {
	{
		[Name=string]: metadata: {
			name:   "\(Name)"
			labels: string
		}
	}
	test: metadata: labels: "test-label"
}
-- out/definition-v3-noshare --
outputs: {
	{
		[Name=string]: metadata: {
			name:   "\(Name)"
			labels: string
		}
	}
	test: metadata: labels: "test-label"
}
-- out/definition --
-- out/doc-v3 --
[]
[outputs]
[outputs test]
[outputs test metadata]
[outputs test metadata labels]
[outputs test metadata name]
-- out/value-v3 --
== Simplified
{
	outputs: test: metadata: {
		name:   "test"
		labels: "test-label"
	}
}
== Raw
{
	outputs: test: metadata: {
		name:   "test"
		labels: "test-label"
	}
}
== Final
{
	outputs: test: metadata: {
		name:   "test"
		labels: "test-label"
	}
}
== All
{
	outputs: test: metadata: {
		name:   "test"
		labels: "test-label"
	}
}
== Eval
{
	outputs: test: metadata: {
		name:   "test"
		labels: "test-label"
	}
}
