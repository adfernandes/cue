# Tests that a for comprehension sees fields contributed to its source by
# sibling conjuncts regardless of declaration order. Issue: evalv3 ran a for
# comprehension while a sibling embedding or if comprehension that adds to the
# comprehension's source was still being evaluated, committing an incomplete
# field set. Depending on declaration order the comprehension then silently
# yielded nothing.
-- in.cue --
// The embedded x contributes a field to m, the source of the for
// comprehension. With the embedding declared first, evalv3 iterated m before
// the embedding was resolved, so the for comprehension never embedded y.
embedBeforeFor: {
	x: {
		m: "from-x": true
		result: "res-x": true
	}
	y: {
		result: "res-y": true
	}

	x
	m: [string]: bool
	for k, v in m {y}

}

// The same with the embedding declared last always worked.
embedAfterFor: {
	x: {
		m: "from-x": true
		result: "res-x": true
	}
	y: {
		result: "res-y": true
	}

	m: [string]: bool
	for k, v in m {y}
	x

}

// An if comprehension contributes a field to the source of a sibling for
// comprehension. With the if declared first, evalv3 iterated a.items while
// the if guard was still being evaluated, so a.results remained empty.
ifBeforeFor: {
	a: {
		flag: bool | *false
		items: [string]:   string
		results: [string]: int
	}

	a: flag: true

	if a.flag == true {
		a: items: item1: "data1"
	}

	for k, v in a.items {
		a: results: (k): 2
	}

}

// The same with the for comprehension declared first always worked.
forBeforeIf: {
	a: {
		flag: bool | *false
		items: [string]:   string
		results: [string]: int
	}

	a: flag: true

	for k, v in a.items {
		a: results: (k): 2
	}

	if a.flag == true {
		a: items: item1: "data1"
	}

}
-- out/compile --
--- in.cue
{
  embedBeforeFor: {
    x: {
      m: {
        "from-x": true
      }
      result: {
        "res-x": true
      }
    }
    y: {
      result: {
        "res-y": true
      }
    }
    〈0;x〉
    m: {
      [string]: bool
    }
    for k, v in 〈0;m〉 {
      〈2;y〉
    }
  }
  embedAfterFor: {
    x: {
      m: {
        "from-x": true
      }
      result: {
        "res-x": true
      }
    }
    y: {
      result: {
        "res-y": true
      }
    }
    m: {
      [string]: bool
    }
    for k, v in 〈0;m〉 {
      〈2;y〉
    }
    〈0;x〉
  }
  ifBeforeFor: {
    a: {
      flag: (bool|*false)
      items: {
        [string]: string
      }
      results: {
        [string]: int
      }
    }
    a: {
      flag: true
    }
    if (〈0;a〉.flag == true) {
      a: {
        items: {
          item1: "data1"
        }
      }
    }
    for k, v in 〈0;a〉.items {
      a: {
        results: {
          〈3;k〉: 2
        }
      }
    }
  }
  forBeforeIf: {
    a: {
      flag: (bool|*false)
      items: {
        [string]: string
      }
      results: {
        [string]: int
      }
    }
    a: {
      flag: true
    }
    for k, v in 〈0;a〉.items {
      a: {
        results: {
          〈3;k〉: 2
        }
      }
    }
    if (〈0;a〉.flag == true) {
      a: {
        items: {
          item1: "data1"
        }
      }
    }
  }
}
