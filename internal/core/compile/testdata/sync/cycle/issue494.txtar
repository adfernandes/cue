# `a: [rn=string]: _Q[0:len(a[rn])]` silently produces wrong output: `a.ben`
# should be `[{pos: 0}]` (a one-element slice matching the concrete entry's
# length) but instead produces `[{}]` with `pos` missing and no error reported.
# The equivalent closed-type pattern `#d: [rn=string]: [...] & _Q[0:len(#d[rn])]`
# works correctly. The self-referential slice constraint is not being unified.
# https://cuelang.org/issue/494
-- in.cue --
_Q: [{pos: 0}, {pos: 1}]

a: [string]~(rn,_): _Q[0:len(a[rn])]
a: ben:             [{}]

b: [string]~(rn,_): _Q[0:1]
b: ben:             [{}]

c: [string]~(rn,_): [...{l: len(a[rn])}]
c: ben:             [{}]

#d: [string]~(rn,_): [...{pos: uint}] & _Q[0:len(#d[rn])]
#d: ben:             [{}]

d: #d

e: [string]~(rn,_): _Q[0 : len(a[rn])+1]
e: ben:             [{}, ...]

f: [string]~(rn,_): _Q[0 : len(a[rn])+1]
f: ben:             [{}]

g: [string]~(rn,_): _Q[0:len(a[rn])]
g: ben:             [{}, {}]
-- out/compile --
--- in.cue
{
  _Q: [
    {
      pos: 0
    },
    {
      pos: 1
    },
  ]
  a: {
    [string]: 〈1;_Q〉[0:len(〈1;a〉[〈0;-〉])]
  }
  a: {
    ben: [
      {},
    ]
  }
  b: {
    [string]: 〈1;_Q〉[0:1]
  }
  b: {
    ben: [
      {},
    ]
  }
  c: {
    [string]: [
      ...{
        l: len(〈3;a〉[〈2;-〉])
      },
    ]
  }
  c: {
    ben: [
      {},
    ]
  }
  #d: {
    [string]: ([
      ...{
        pos: &(int, >=0)
      },
    ] & 〈1;_Q〉[0:len(〈1;#d〉[〈0;-〉])])
  }
  #d: {
    ben: [
      {},
    ]
  }
  d: 〈0;#d〉
  e: {
    [string]: 〈1;_Q〉[0:(len(〈1;a〉[〈0;-〉]) + 1)]
  }
  e: {
    ben: [
      {},
      ...,
    ]
  }
  f: {
    [string]: 〈1;_Q〉[0:(len(〈1;a〉[〈0;-〉]) + 1)]
  }
  f: {
    ben: [
      {},
    ]
  }
  g: {
    [string]: 〈1;_Q〉[0:len(〈1;a〉[〈0;-〉])]
  }
  g: {
    ben: [
      {},
      {},
    ]
  }
}
