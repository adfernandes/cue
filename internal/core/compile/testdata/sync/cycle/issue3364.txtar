# Structural recursion that used to loop forever now reports a structural cycle.
# https://cuelang.org/issue/3364
-- in.cue --
out: _t3.out
_t3: {
	repeater: {let L = self, L.a}
	data:     {let M = self, a: a: M}
	out:      repeater & data
}
-- out/compile --
--- in.cue
{
  out: 〈0;_t3〉.out
  _t3: {
    repeater: {
      let L#1 = 〈1〉
      〈0;let L#1〉.a
    }
    data: {
      let M#2 = 〈1〉
      a: {
        a: 〈1;let M#2〉
      }
    }
    out: (〈0;repeater〉 & 〈0;data〉)
  }
}
