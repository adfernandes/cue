# Pinned to v0.17.0: root-embedding series with close(), covering how a
# closed embedding constrains its siblings before explicitopen is
# stable.
-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.17.0"
-- in.cue --
c: "foo"
a: b: int
#Schema
#Schema: close({ a: b: int})

x: {
	c: "foo"
	a: b: int
	#Schema
	#Schema: close({ a: b: int})
}

-- out/compile --
--- in.cue
{
  c: "foo"
  a: {
    b: int
  }
  〈0;#Schema〉
  #Schema: close({
    a: {
      b: int
    }
  })
  x: {
    c: "foo"
    a: {
      b: int
    }
    〈0;#Schema〉
    #Schema: close({
      a: {
        b: int
      }
    })
  }
}
