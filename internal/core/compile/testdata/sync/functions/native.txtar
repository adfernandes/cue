-- in.cue --
@experiment(functions)

arguments: {
	sum: {
		fn: func(a: int, b: int) -> int: a + b

		positional: fn(1, 2)
		labeled:    fn(a: 1, b: 2)
		mixed:      fn(1, b: 2)

		tooMany:        fn(1, 2, 3)
		unknownLabeled: fn(a: 1, b: 2, c: 3)
		duplicateArg:   fn(1, a: 2)
		duplicateLabeled: fn(a: 1, a: 2)
	}

	alias: {
		add1:     func(_~x: int) -> int: x + 1
		addNamed: func(_~x: int, a: int) -> int: x + a

		positional: add1(1)
		beforeNamed: addNamed(1, 2)
		mixed:       addNamed(1, a: 2)
	}

	keyword: {
		fn: func(a!: int, b?: int) -> int: a

		nameOnly:   fn(a: 4)
		positional: fn(4)
	}

	order: {
		fn:       func(int, a: int) -> int: a
		required: func(int, a!: int) -> int: a

		positionalThenNamed: fn(1, a: 2)
		allPositional:       fn(1, 2)
		requiredNamed:       required(1, a: 2)
	}

	missing: {
		positional: (func(int) -> int: 1)()
		named:      (func(a: int) -> int: a)()
	}

	builtin: {
		labeled: len(x: "foo")
	}
}

defaults: {
	value:   int | *6
	pick:    func(a: int | *5) -> int: a
	pickRef: func(a: value) -> int: a
	pickAmbiguous: func(a: int | *1 | *2) -> int: a
	pickRecursive: func(a: int | *pickRecursive()) -> int: a
	pickMutualA:   func(a: int | *pickMutualB()) -> int: a
	pickMutualB:   func(a: int | *pickMutualA()) -> int: a

	literal:   pick()
	reference: pickRef()
	ambiguous: pickAmbiguous()
	recursive: pickRecursive()
	mutualRecursive: pickMutualA()
}

scoping: {
	capture: {
		base: 10
		fn:   func(a: int) -> int: a + base

		sameScope: fn(2)
		callerArg: {
			local: 3
			out:   fn(local)
		}
	}

	parameter: {
		a: int | *7
		fn: func(a: string, b: a) -> int: b
		out: fn("shadow")
		selected: {
			out: fn("shadow")
		}
	}

	returnType: {
		a: string
		fn: func(a: int) -> a: a
		out: fn(1)
	}

	returnConstraint: (func() -> string: 1)()
}

cycles: {
	direct: {
		fn:  func(n: int) -> int: fn(n)
		out: fn(1)
	}

	mutual: {
		a:   func(n: int) -> int: b(n)
		b:   func(n: int) -> int: a(n)
		out: a(1)
	}

	fibonacci: {
		fib: func(n: int) -> int: fib(n-1) + fib(n-2)
		out: fib(5)
	}

	ackermann: {
		fn:  func(m: int, n: int) -> int: fn(m-1, fn(m, n-1))
		out: fn(2, 2)
	}

	// Non-recursive nesting of calls to the same function must NOT be flagged
	// as a cycle. This guards against collapsing all calls to one identity.
	nesting: {
		sum:   func(a: int, b: int) -> int: a + b
		twice: func(n: int) -> int: sum(n, n)
		out:   twice(twice(2))
	}
}

// A parameter may share its name with the synthetic label under which a call
// selects its result. This guards against the result arc colliding with a
// parameter arc in the call instance.
paramNamedOut: {
	f: func(out: int) -> int: out + 1
	x: f(3)

	g: func(_~out: int) -> int: out * 2
	y: g(5)
}
-- out/compile --
--- in.cue
{
  arguments: {
    sum: {
      fn: func
      positional: 〈0;fn〉(1, 2)
      labeled: 〈0;fn〉(a: 1, b: 2)
      mixed: 〈0;fn〉(1, b: 2)
      tooMany: 〈0;fn〉(1, 2, 3)
      unknownLabeled: 〈0;fn〉(a: 1, b: 2, c: 3)
      duplicateArg: 〈0;fn〉(1, a: 2)
      duplicateLabeled: 〈0;fn〉(a: 1, a: 2)
    }
    alias: {
      add1: func
      addNamed: func
      positional: 〈0;add1〉(1)
      beforeNamed: 〈0;addNamed〉(1, 2)
      mixed: 〈0;addNamed〉(1, a: 2)
    }
    keyword: {
      fn: func
      nameOnly: 〈0;fn〉(a: 4)
      positional: 〈0;fn〉(4)
    }
    order: {
      fn: func
      required: func
      positionalThenNamed: 〈0;fn〉(1, a: 2)
      allPositional: 〈0;fn〉(1, 2)
      requiredNamed: 〈0;required〉(1, a: 2)
    }
    missing: {
      positional: func()
      named: func()
    }
    builtin: {
      labeled: len(x: "foo")
    }
  }
  defaults: {
    value: (int|*6)
    pick: func
    pickRef: func
    pickAmbiguous: func
    pickRecursive: func
    pickMutualA: func
    pickMutualB: func
    literal: 〈0;pick〉()
    reference: 〈0;pickRef〉()
    ambiguous: 〈0;pickAmbiguous〉()
    recursive: 〈0;pickRecursive〉()
    mutualRecursive: 〈0;pickMutualA〉()
  }
  scoping: {
    capture: {
      base: 10
      fn: func
      sameScope: 〈0;fn〉(2)
      callerArg: {
        local: 3
        out: 〈1;fn〉(〈0;local〉)
      }
    }
    parameter: {
      a: (int|*7)
      fn: func
      out: 〈0;fn〉("shadow")
      selected: {
        out: 〈1;fn〉("shadow")
      }
    }
    returnType: {
      a: string
      fn: func
      out: 〈0;fn〉(1)
    }
    returnConstraint: func()
  }
  cycles: {
    direct: {
      fn: func
      out: 〈0;fn〉(1)
    }
    mutual: {
      a: func
      b: func
      out: 〈0;a〉(1)
    }
    fibonacci: {
      fib: func
      out: 〈0;fib〉(5)
    }
    ackermann: {
      fn: func
      out: 〈0;fn〉(2, 2)
    }
    nesting: {
      sum: func
      twice: func
      out: 〈0;twice〉(〈0;twice〉(2))
    }
  }
  paramNamedOut: {
    f: func
    x: 〈0;f〉(3)
    g: func
    y: 〈0;g〉(5)
  }
}
