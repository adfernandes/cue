# An @experiment attribute is redundant once the experiments it names are
# stable at the file's language version, so cue fix should drop those names
# and leave the rest of the attribute alone.
#
# TODO(fix): aliasv2 is stable as of v0.18.0, so stable.cue should lose its
# attribute entirely and mixed.cue should keep only @experiment(try).
# Today cue fix leaves every attribute untouched.
exec cue fix .
cmp stable.cue expect/stable
cmp mixed.cue expect/mixed
cmp preview.cue expect/preview

-- cue.mod/module.cue --
module: "mod.test"

language: version: "v0.18.0"
-- stable.cue --
@experiment(aliasv2)

package p

a: 1
-- mixed.cue --
@experiment(aliasv2,try)

package p

b: 2
-- preview.cue --
@experiment(try)

package p

c: 3
-- expect/stable --
@experiment(aliasv2)

package p

a: 1
-- expect/mixed --
@experiment(aliasv2,try)

package p

b: 2
-- expect/preview --
@experiment(try)

package p

c: 3
