# Data files named on the command line are unified with the package,
# just like for commands such as "cue export".
exec cue cmd show . data.json data.yaml
cmp stdout json-yaml.golden

# Every value of a stream, such as a multi-document YAML file, is unified too.
exec cue cmd show . stream.yaml
cmp stdout stream.golden

# Interpretations which need a schema, such as textproto, use the package.
exec cue cmd show . data.textproto
cmp stdout textproto.golden

# Data files can also be merged into a package given as a list of files,
# which must then include the tool files.
exec cue cmd show test.cue show_tool.cue data.json
cmp stdout json.golden

# Definitions in the package remain visible to the tool files.
exec cue cmd defs . data.json
cmp stdout defs.golden

# Data which conflicts with the package is reported as such.
! exec cue cmd show . bad.json
cmp stderr bad.golden

# CUE files named alongside a package stay in their own instance; only the
# data files are unified into the package.
exec cue cmd show ./_mixed _other/extra.cue data.json
cmp stdout mixed.golden

# Data files are not merged implicitly; they must be named.
! exec cue cmd show .
cmp stderr incomplete.golden

# Data files cannot be combined with more than one package.
! exec cue cmd show ./... data.json
cmp stderr toomany.golden

-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.14.0"
-- test.cue --
package test

#Def: "def"

j: string
y?: string
-- show_tool.cue --
package test

import "tool/exec"

command: show: print: exec.Run & {
	cmd: "echo \(j) \(*y | "-")"
}
command: defs: print: exec.Run & {
	cmd: "echo \(j) \(#Def)"
}
-- sub/sub.cue --
package test
-- _mixed/mixed.cue --
package mixed

j: string
-- _mixed/show_tool.cue --
package mixed

import "tool/exec"

command: show: print: exec.Run & {
	cmd: "echo \(j) \(k)"
}
-- _other/extra.cue --
package mixed

k: "extra"
-- data.json --
{"j": "json"}
-- data.yaml --
y: yaml
-- bad.json --
{"j": 3}
-- stream.yaml --
j: "one"
---
y: "two"
-- data.textproto --
j: "textproto"
-- json-yaml.golden --
json yaml
-- stream.golden --
one two
-- textproto.golden --
textproto -
-- json.golden --
json -
-- defs.golden --
json def
-- mixed.golden --
json extra
-- bad.golden --
j: conflicting values string and 3 (mismatched types string and int):
    ./bad.json:1:7
    ./test.cue:5:4
-- incomplete.golden --
command.show.print.cmd: invalid interpolation:
    ./show_tool.cue:6:7
    ./test.cue:5:4
-- toomany.golden --
too many packages defined (2) in combination with files
