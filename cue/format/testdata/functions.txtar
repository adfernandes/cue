-- functions.input --
@experiment(functions)

sum: func(
    _~x: int,
    // left operand
    a: int | *5,
    req!: string,
    opt?: bool,
) -> int: call(x, a: a, req: req)

mixed: sum(1, req: "x")

tagged: func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b

open:      func(a: int, ...) -> number
openOnly:  func(...) -> int
openMulti: func(
    // first operand
    a: int,
    b?: string,
    ...
) -> int
-- out/format/functions.golden --
@experiment(functions)

sum: func(
	_~(x): int,
	// left operand
	a: int | *5,
	req!: string,
	opt?: bool,
) -> int: call(x, a: a, req: req)

mixed: sum(1, req: "x")

tagged: func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b

open:     func(a: int, ...) -> number
openOnly: func(...) -> int
openMulti: func(
	// first operand
	a: int,
	b?: string,
	...
) -> int
