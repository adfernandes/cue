// This files tests that values are properly "frozen" in case of mutual
// references. Non-structural cyclic references are okay, as long a property
// that is dependended upon in the cycle is not changed after the fact,
// that is, a value may not become more specific after it is used.
-- in.cue --
freezing: t1: ok: {
	#a: x: "a"
	len(#a) // 1
	@test(eq, {1, #a: {x: "a"}})
}

-- comprehension.cue --
// This should be an incomplete error, as z is inserted in x, over which the
// comprehension loops. Adding a field z to x would fix this.
// This test would fail in the old evaluator, depending on ordering.
comprehension: t1: _
comprehension: t1: ok:{
	@test(permute, count=)

	x: y: {}
	// order of comprehensions matter in old evaluator.
	for _ in x {
		if true { x: z: a: {} }
	}
	if true {
		if true { x: z: a: {} }
	}
	@test(eq, {x: {y: {}, z: {a: {}}}})
}

comprehension: t2: err: {
	a: {
		x: 1
		for k, v in a {
			(k+"q"): v // This increases the set of fields in a.
		}
		@test(err, code=eval, contains="adding field %v not allowed as field set was already referenced", args=[xq], pos=[3:13])
	}
}

comprehension: t3: err: {
	// mutual dependencies not okay in this case, as the set of fields grows.
	a: x: 1
	b: y: 1
	a: {
		for k, v in b {
			(k+"q"): v
		}
		@test(err, code=eval,
			suberr=(code=eval, contains="adding field %v not allowed as field set was already referenced", args=[yq], pos=[2:13]),
			suberr=(code=eval, contains="adding field %v not allowed as field set was already referenced", args=[xq], pos=[2:13]))
	}
	b: {
		for k, v in a {
			(k): v
		}
		@test(eq, {y: 1, x: 1})
	}
}

comprehension: t4: ok: {
	// It is okay to make x more specific as long as no fields are added.
	x: y: {}
	for _ in x {
		if true { x: y: a: {} }
	}
	@test(eq, {x: {y: {a: {}}}})
}

// A let in the body of a comprehension that iterates over the struct it
// inserts into is inserted after the struct's field set was frozen. Let arcs
// are invisible to the iteration, so adding one is fine.
// https://cuelang.org/issue/4478
comprehension: letInBody: ok: {
	nodes: n1: index: 1
	nodes: n2: index: 2
	nodes: {
		for name, value in nodes {
			let derived = value.index + 10
			(name): address: derived
		}
	}
	@test(eq, {nodes: {n1: {index: 1, address: 11}, n2: {index: 2, address: 12}}})
}

comprehension: moreSpecific: ok: {
	a: {
		x: int
		for k, v in a {
			(k): 1
		}
		@test(eq, {x: 1})
	}
}

comprehension: moreSpecific: err: {
	a: {
		x: {y: 1}
		// len(v) should free the size of x.
		for k, v in a if len(v) > 0 {
			(k): {z: 1}
		}
		@test(err, code=eval, path=x,
			contains="adding field %v not allowed as field set was already referenced", args=[z], pos=[4:9])
	}
}
-- issue3178.cue --
// evalv3 regression: exporting via the Go API produced an error that evalv2
// did not, for a case involving chained comprehensions.
// https://cuelang.org/issue/3178
issue3178: {
	// This should pass. Reasoning:
	// - second comprehension runs
	// - in order to satisfy, first comprehension must run
	// - first comprehension runs and completes
	input: [ "Value" ]
	output: {...}
	for name in input {
			output: "\(name)": true
	}
	for name, v in output {
	}
	@test(eq, {input: ["Value"], output: {Value: true}})
}
-- issue2615.cue --
// Growing the field set of a struct that a comprehension already iterated
// over is not allowed. The error message should make the cause clear and
// point at the comprehension.
// https://cuelang.org/issue/2615
issue2615: {
	repos?: [string]: {
		trybot: *false | bool
	}
	repos: cue: trybot: true
	for n, r in repos if r.trybot {
		repos: "\(n)-trybot": trybot: false
	}
	@test(err, at=repos, code=eval, incorrect,
		contains="adding field %v not allowed as field set was already referenced", pos=[6:25])
	@test(err:todo, at=repos, code=eval, p=1,
		contains="adding field %v not allowed as field set was already iterated over by comprehension")
}
