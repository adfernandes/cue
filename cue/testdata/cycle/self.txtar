-- in.cue --
import "list"

expr: error1: {
	a: 3
	a: a + 1
	@test(err, code=eval, path=a, contains="conflicting values %s and %s", args=[4, 3], pos=[1:5, 2:5])
}
expr: error2: {
	a: a + 1
	a: 3
	@test(err, code=eval, path=a, contains="conflicting values %s and %s", args=[4, 3], pos=[1:5, 2:5])
}
listConcat: error1: {
	a: ["1", "2"]
	a: list.Concat([a, ["3"]])
	@test(err, code=structural_cycle, path=a, contains="error in call to %s", args=[list.Concat], pos=[2:5])
}

listConcat: error2: {
	a: list.Concat([["3"], a])
	a: ["1", "2"]
	@test(err, code=structural_cycle, path=a, contains="error in call to %s", args=[list.Concat], pos=[1:5])
}

selfEmbed: ok1: {
	a: x
	Y: x
	x: {Y}
	@test(eq, {a: {}, Y: {}, x: {}})
}

selfEmbed: ok2: {
	Y: x.b
	a: x
	x: b: {Y}
	@test(eq, {Y: {}, a: {b: {}}, x: {b: {}}})
}

selfEmbed: ok3: {
	Y: x
	a: x
	x: {Y}
	@test(eq, {Y: {}, a: {}, x: {}})
}

selfEmbed: ok4: {
	a: x
	x: {Y}
	Y: x
	@test(eq, {a: {}, x: {}, Y: {}})
}

selfEmbed: ok5: {
	x: {Y}
	a: x
	Y: x
	@test(eq, {x: {}, a: {}, Y: {}})
}

selfEmbed: ok6: {
	x: b: {Y}
	Y: x.b
	a: x
	@test(eq, {x: {b: {}}, Y: {}, a: {b: {}}})
}


disjSelf: ok1: {
	#A: string | #A
	x: #A
	@test(eq, {#A: string | _, x: string | _})
}

disjSelf: ok2: {
	x: #A
	#A: string | #A
	@test(eq, {x: string | _, #A: string | _})
}

disjSelf: ok3: {
	#A: #A | string
	x: #A
	@test(eq, {#A: _ | string, x: _ | string})
}

disjSelf: ok4: {
	x: #A
	#A: #A | string
	@test(eq, {x: _ | string, #A: _ | string})
}

disjEmbed: ok1: {
	#A: string | {#A}
	x: #A
	@test(eq, {#A: string | {}, x: string | {}})
}

disjEmbed: ok2: {
	x: #A
	#A: string | {#A}
	@test(eq, {x: string | {}, #A: string | {}})
}

disjEmbed: ok3: {
	#A: {#A} | string
	x: #A
	@test(eq, {#A: {} | string, x: {} | string})
}

disjEmbed: ok4: {
	x: #A
	#A: {#A} | string
	@test(eq, {x: {} | string, #A: {} | string})
}

// x and #A should yield the same result.
disjList: _
disjList: ok1: {
	#A: string | [#A]
	x: #A

	y: x
	y: [[[[string]]]]
	@test(eq, {
		#A: string
		x: string
		y: [[[[string]]]]
	})
}

disjList: ok2: {
	x: #A
	#A: string | [#A]
	@test(eq, {x: string, #A: string})
}

disjList: ok3: {
	#A: [#A] | string
	x: #A
	@test(eq, {#A: string, x: string})
}

disjList: ok4: {
	x: #A
	#A: [#A] | string
	@test(eq, {x: string, #A: string})
}

-- selfnew.cue --
issue4125: t1_self: {
	let Root = self
	a: Root.a
	@test(eq, {a: _})
}
// A struct literal that only embeds an expression has no value of its own, so
// a reference to the enclosing field from within it is a cycle, as for the
// bare ref fields; both as an operand and as a call argument. Optional fields
// and patterns give it no value either: its kind is that of the embedding.
structEmbed: cycle: {
	ref1: ref1 + 1     @test(err, code=cycle, contains="cycle with field: ref1", pos=[0:8])
	ref2: div(ref2, 2) @test(err, code=incomplete)

	lit1: {lit1 + 1}          @test(err, code=eval, contains="invalid operands", pos=[0:9, 0:8, 0:16], incorrect) @test(err:todo, code=cycle, contains="cycle with field: lit1")
	lit2: {div(lit2, 2)}      @test(err, code=eval, contains="cannot use", pos=[0:8], incorrect) @test(err:todo, code=incomplete)
	lit3: {2 * div(lit3, 2)}  @test(err, code=eval, contains="cannot use", pos=[0:8], incorrect) @test(err:todo, code=incomplete)
	lit4: {b?: int, lit4 + 1} @test(err, code=eval, contains="invalid operands", pos=[0:18, 0:8, 0:25], incorrect) @test(err:todo, code=cycle, contains="cycle with field: lit4")
	val:  {b?: int, 3}        @test(eq, 3)
}

// A struct literal with a regular field, or without embeddings, is a struct:
// an operation on it from within an embedding is a type error, not a cycle.
structEmbed: struct: {
	a: {}
	a: a + 1
	@test(err, code=eval, path=a, contains="invalid operands %s and %s", args=[{}, 1], pos=[2:5, 1:5, 2:9])
}

