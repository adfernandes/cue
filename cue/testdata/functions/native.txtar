-- in.cue --
@experiment(functions)

import "strings"

arguments: {
	sum: {
		fn: func(a: int, b: int) -> int: a + b

		positional: fn(1, 2) @test(eq, 3)
		labeled:    fn(a: 1, b: 2) @test(eq, 3)
		mixed:      fn(1, b: 2) @test(eq, 3)

		tooMany:        fn(1, 2, 3) @test(err, code=eval, contains="too many positional arguments")
		unknownLabeled: fn(a: 1, b: 2, c: 3) @test(err, code=eval, contains="unknown argument c")
		duplicateArg:   fn(1, a: 2) @test(err, code=eval, contains="argument a provided by position and label")
		duplicateLabeled: fn(a: 1, a: 2) @test(err, code=eval, contains="duplicate argument a")
	}

	alias: {
		add1:     func(_~x: int) -> int: x + 1
		addNamed: func(_~x: int, a: int) -> int: x + a

		positional: add1(1) @test(eq, 2)
		beforeNamed: addNamed(1, 2) @test(eq, 3)
		mixed:       addNamed(1, a: 2) @test(eq, 3)
	}

	keyword: {
		fn: func(a!: int, b?: int) -> int: a

		nameOnly:   fn(a: 4) @test(eq, 4)
		positional: fn(4) @test(err, code=eval, contains="missing required argument a")
	}

	order: {
		fn:       func(int, a: int) -> int: a
		required: func(int, a!: int) -> int: a

		positionalThenNamed: fn(1, a: 2) @test(eq, 2)
		allPositional:       fn(1, 2) @test(eq, 2)
		requiredNamed:       required(1, a: 2) @test(eq, 2)
	}

	missing: {
		positional: (func(int) -> int: 1)() @test(err, code=eval, contains="not enough arguments")
		named:      (func(a: int) -> int: a)() @test(err, code=eval, contains="missing argument a")
	}

	builtin: {
		labeled: len(x: "foo") @test(err, code=eval, contains="labeled arguments are not supported for builtin")
	}
}

defaults: {
	value:   int | *6
	pick:    func(a: int | *5) -> int: a
	pickRef: func(a: value) -> int: a
	pickAmbiguous: func(a: int | *1 | *2) -> int: a
	pickRecursive: func(a: int | *pickRecursive()) -> int: a
	pickMutualA:   func(a: int | *pickMutualB()) -> int: a
	pickMutualB:   func(a: int | *pickMutualA()) -> int: a

	literal:   pick() @test(eq, int | *5)
	reference: pickRef() @test(eq, int | *6)
	ambiguous: pickAmbiguous() @test(err, code=eval, contains="missing argument a")
	recursive: pickRecursive() @test(err, code=eval, contains="missing argument a")
	mutualRecursive: pickMutualA() @test(err, code=eval, contains="missing argument a")
}

scoping: {
	capture: {
		base: 10
		fn:   func(a: int) -> int: a + base

		sameScope: fn(2) @test(eq, 12)
		callerArg: {
			local: 3
			out:   fn(local) @test(eq, 13)
		}
	}

	parameter: {
		// A parameter constraint resolves in the scope enclosing the function,
		// so it may refer to an outer field (but not to another parameter; see
		// TestFunctionParameterScope).
		base: int | *7
		fn:   func(a: string, b: base) -> int: b
		out:  fn("shadow") @test(eq, int | *7)
		selected: {
			out: fn("shadow")
			@test(eq, {
				out: 7 @test(final)
			})
		}
	}

	returnType: {
		// The return type also resolves in the enclosing scope and is enforced
		// on the result of a call.
		bound: <10
		fn:    func(a: int) -> bound: a
		ok:    fn(5) @test(eq, 5)
		bad:   fn(50) @test(err, code=eval, contains="out of bound")
	}

	returnConstraint: (func() -> string: 1)() @test(err, code=eval, contains="conflicting values %s and %s (mismatched types %s and %s)", args=[1, string, int, string])

	// The reserved-parameter rule applies one signature at a time: a function
	// literal nested within another function's signature or body resolves its
	// own parameters in its own body as usual.
	nested: {
		// A function-typed result: the body closes over the outer parameter
		// (currying).
		curry: {
			adder: func(x: int) -> (func(y: int) -> int): func(y: int) -> int: x + y
			add3:  adder(3)
			out:   add3(4) @test(eq, 7)
		}

		// A function literal with a body in a parameter constraint refers to
		// its own parameter.
		paramDefault: {
			f:   func(g: int | *(func(a: int) -> int: a + 1)) -> int: 1
			out: f(2) @test(eq, 1)
		}

		// The same, in a return-type disjunction.
		returnDisjunct: {
			f:   func(x: int) -> (int | (func(a: int) -> int: a)): x
			out: f(3) @test(eq, 3)
		}

		// A function nested in the outer function's body may refer to the
		// outer parameter from its own signature: it is not one of its own
		// parameters.
		outerParam: {
			f: func(x: int) -> int: {
				g:   func(y: x) -> int: y
				out: g(x)
			}.out
			out: f(5) @test(eq, 5)
		}
	}
}

cycles: {
	direct: {
		fn:  func(n: int) -> int: fn(n)
		out: fn(1) @test(err, code=structural_cycle, contains="structural cycle")
	}

	mutual: {
		a:   func(n: int) -> int: b(n)
		b:   func(n: int) -> int: a(n)
		out: a(1) @test(err, code=structural_cycle, contains="structural cycle")
	}

	fibonacci: {
		fib: func(n: int) -> int: fib(n-1) + fib(n-2)
		out: fib(5) @test(err, code=structural_cycle, contains="structural cycle")
	}

	ackermann: {
		fn:  func(m: int, n: int) -> int: fn(m-1, fn(m, n-1))
		out: fn(2, 2) @test(err, code=structural_cycle, contains="structural cycle")
	}

	// A recursive call in a disjunct of the function body is a structural
	// cycle and is eliminated from the disjunction, like any other erroring
	// disjunct. It must not be absorbed and survive as the function's
	// return type (this used to yield 1 | int).
	disjunct: {
		f:   func(n: int) -> int: n | f(n)
		out: f(1) @test(eq, 1)

		// If every disjunct recurses, the call fails as a structural cycle.
		g:   func(n: int) -> int: g(n+1) | g(n)
		bad: g(1) @test(err, code=structural_cycle, contains="empty disjunction")

		// A non-recursive call in a disjunct evaluates normally: the
		// disjunction of both branches survives.
		inc:  func(n: int) -> int: n + 1
		h:    func(n: int) -> int: n | inc(n)
		both: h(1) @test(eq, 1 | 2)

		// Mutual recursion through a disjunct is eliminated as well.
		ma:   func(n: int) -> int: mb(n)
		mb:   func(n: int) -> int: n | ma(n)
		out2: mb(1) @test(eq, 1)
	}

	// Non-recursive nesting of calls to the same function must NOT be flagged
	// as a cycle. This guards against collapsing all calls to one identity.
	nesting: {
		sum:   func(a: int, b: int) -> int: a + b
		twice: func(n: int) -> int: sum(n, n)
		out:   twice(twice(2)) @test(eq, 8)

		// Deeper nesting: the argument of each call is itself a call whose
		// body re-enters the same call site (sum inside twice). The
		// argument's evaluation must keep the caller's cycle-reference
		// context rather than adopt the enclosing body's chain, or the
		// sum call site falsely re-appears in one chain at depth >= 3.
		deep: twice(twice(twice(2))) @test(eq, 16)
		d4:   twice(twice(twice(twice(2)))) @test(eq, 32)

		// A helper whose body merely forwards to another function: nesting
		// the helper re-enters the twice call site inside h's body through
		// the lazily evaluated arguments.
		h:     func(n: int) -> int: twice(n)
		alias: h(h(h(1))) @test(eq, 8)

		// A cycle must not be misattributed to an unrelated intermediate
		// field consumed as an argument.
		mid:   twice(2) @test(eq, 4)
		outer: twice(twice(mid)) @test(eq, 16)

		// An identity body returns its parameter: the result structure-shares
		// the argument, which in a nested call is again a call to the same
		// function.
		f:     func(v: int) -> int: v
		ident: f(f(f(3))) @test(eq, 3)
	}
}

// Calling a disjunction is only possible once it has resolved to a single
// callee: an unresolved disjunction is ambiguous, and, since further
// unification may still resolve it, calling one is an incomplete error
// rather than a permanent one. This guards against the crash class where
// the callee evaluates to no single value at all.
disjunction: {
	f: func(a: int) -> int: a
	g: func(a: int) -> int: a + 1

	// It is unknown which disjunct to call.
	ambiguous: {
		h:   f | g
		out: h(1) @test(err, code=incomplete, contains="unresolved disjunction")
	}

	// A disjunction with a single default of function kind resolves to
	// its default and the call proceeds.
	defaulted: {
		h:   *f | g
		out: h(1) @test(eq, 1)
	}

	// Disjuncts that dedup to a single value remain callable.
	dedup: {
		h:   f | f
		out: h(1) @test(eq, 1)
	}

	// The same crash class applies to other callee kinds: builtins and
	// disjunctions mixing a function with a non-function.
	builtins: {
		h:   strings.ToUpper | strings.ToLower
		out: h("Hello") @test(err, code=incomplete, contains="unresolved disjunction")
	}
	mixed: {
		h:   f | 1
		out: h(1) @test(err, code=incomplete, contains="unresolved disjunction")
	}

	// Callees that are themselves errors or incomplete fail gracefully.
	callee: {
		bottom: (1 & 2)(1) @test(err, code=eval, contains="conflicting values")
		incomplete: {
			x:   _
			out: x(1) @test(err, code=incomplete, contains="cannot call non-concrete value")
		}
	}
}

// Memoized call results must be matched on the callee, not just on the call
// site: overlay cloning shares environment pointers across disjunct branches,
// so the same call site may be dispatched to different callees per branch.
memoization: {
	f: func(a: int) -> int: a + 1
	g: func(a: int) -> int: a + 2

	x: {h: _, out: h(10)}
	x: {h: f} | {h: g}

	// Unifying with out: 12 eliminates the f branch and keeps the g branch.
	// A memoized result leaking from the f branch would empty the
	// disjunction instead.
	y: x & {out: 12}
	check: y.out @test(eq, 12)

	// The callee identity includes the arguments bound by partial
	// application.
	partialArgs: {
		add: func(a: int, b: int) -> int: a + b

		x: {h: _, out: h(10)}
		x: {h: add(1, ...)} | {h: add(2, ...)}

		y: x & {out: 12}
		check: y.out @test(eq, 12)
	}
}

// An argument that is not yet defined makes the call incomplete, exactly like
// len(y.q): the result may still become known when more information arrives,
// and until then the result must not be used, let alone be memoized.
incompleteArgs: {
	f: func(a: int) -> string: "ok"
	y: {}
	x: f(y.q) @test(err, code=incomplete, contains="undefined field: q")

	// The equivalent builtin call behaves the same way.
	z: len(y.q) @test(err, code=incomplete, contains="undefined field: q")

	// A later conjunct may still supply the field, in which case the call
	// completes.
	resolved: {
		w: {}
		out: f(w.q) @test(eq, "ok")
		w: q: 1
	}
}

// A parameter may share its name with the synthetic label under which a call
// selects its result. This guards against the result arc colliding with a
// parameter arc in the call instance.
paramNamedOut: {
	f: func(out: int) -> int: out + 1
	x: f(3) @test(eq, 4)

	g: func(_~out: int) -> int: out * 2
	y: g(5) @test(eq, 10)
}

// Parameter lists are a restricted form of struct declarations. Parameters
// may carry field-style attributes, which do not affect evaluation. A
// trailing "..." marks a bodyless signature as open (a partial signature).
declarations: {
	attrs: {
		f:   func(a: int @tag(x), b: int @foo() @bar()) -> int: a + b
		out: f(1, 2) @test(eq, 3)
	}

	open: {
		// An open signature admits further parameters supplied by the closed
		// implementation with which it is unified.
		T:   func(a: int, ...) -> number
		f:   T & (func(a: int, b: int) -> int: a + b)
		out: f(3, 4) @test(eq, 7)

		// A bodyless signature remains a type and cannot be called directly.
		bad: T(1) @test(err, code=eval, contains="cannot call function without implementation")
	}
}

// A call written with a trailing "..." is a partial application: it binds the
// given arguments and yields a function over the remaining parameters, rather
// than evaluating the body.
partial: {
	add: func(a: int, b: int, c: int) -> int: a + b + c

	// Bind by label or by position; the result is a function of the rest.
	byLabel:    add(a: 1, ...)
	byPosition: add(1, ...)
	labelOut:   byLabel(2, 3) @test(eq, 6)
	posOut:     byPosition(2, 3) @test(eq, 6)

	// Binding no arguments yields an equivalent function.
	none: add(...)
	noneOut: none(1, 2, 3) @test(eq, 6)

	// Binding every argument still yields a function; call it with no
	// arguments to evaluate the body.
	all:    add(1, 2, 3, ...)
	allOut: all() @test(eq, 6)

	// Partial applications chain, accumulating bound arguments.
	step1:   add(1, ...)
	step2:   step1(2, ...)
	chainOut: step2(3) @test(eq, 6)

	// Completing a partial application by label binds the remaining
	// parameter.
	half:     add(1, 2, ...)
	halfOut:  half(c: 3) @test(eq, 6)

	// A parameter left unbound after a non-partial call is still required.
	missing: byPosition(2) @test(err, code=eval, contains="missing argument c")

	// Parameter constraints are enforced across a partial application.
	bounded: func(a: int, b: <10) -> int: a + b
	pinned:  bounded(1, ...)
	oob:     pinned(50) @test(err, code=eval, contains="out of bound")

	// A surplus argument to a partial application is rejected, as for a
	// complete call.
	tooMany: add(1, 2, 3, 4, ...) @test(err, code=eval, contains="too many positional arguments")

	// Recursion through a partial application is still bounded by the
	// structural cycle detector.
	rec:    func(n: int) -> int: rec(n)
	recP:   rec(...)
	recOut: recP(1) @test(err, code=structural_cycle, contains="structural cycle")

	// Two partial applications are equal only when they bound the same
	// arguments: different bindings conflict like any other distinct
	// function values, and must not silently merge into one of the two.
	conflictArgs: add(1, ...) & add(2, ...) @test(err, code=eval, contains="conflicting values")

	// A plain function and a partial application of itself differ the same
	// way.
	conflictPlain: add & add(1, ...) @test(err, code=eval, contains="conflicting values")

	// A partial application does unify with itself.
	same:    step1 & step1
	sameOut: same(2, 3) @test(eq, 6)
}
