# Tests unification of native function values with function types (bodyless
# signatures, possibly partial/open) and of function types with each other.
# Static checks at unification time cover only what is decidable from the
# compiled signatures: parameter names, positions, requiredness flags, and
# closedness. Parameter and result constraint conflicts, defaults, and
# missing arguments remain dynamic and surface when the function is called.
-- in.cue --
@experiment(functions)

tighten: {
	T: func(a: int, ...) -> number

	// The value declares an extra parameter b; T's signature is open, so
	// the extra parameter is allowed and kept.
	f: T & (func(a: int, b: int) -> int: a + b)
	x: f(1, 2) @test(eq, 3)
	y: f(1) @test(err, code=eval, contains="missing argument b")

	// Order of unification does not matter.
	fRev: (func(a: int, b: int) -> int: a + b) & T
	xRev: fRev(1, 2) @test(eq, 3)

	// The type's result constraint is enforced on calls through the
	// tightened value.
	r: (T & (func(a: int) -> int: a))(3) @test(eq, 3)
	retConflict: ((func(a: int, ...) -> string) & (func(a: int) -> int: a))(3) @test(err, code=eval, contains="conflicting values")

	// A parameter constraint conflict (int versus string) is not decidable
	// from the signature shapes alone and surfaces when called, not when
	// the type and value are unified.
	s:    T & (func(a: string) -> int: 1)
	sErr: s(1) @test(err, code=eval, contains="conflicting values")
}

closed: {
	U: func(a: int) -> number

	// An exact signature match tightens.
	g:  U & (func(a: int) -> int: a)
	gx: g(1) @test(eq, 1)

	// The type declares parameter a, which the value does not accept.
	bad1: U & (func(b: int) -> int: b) @test(err, code=eval, contains="parameter a of function type not allowed by closed function")

	// The value requires an extra parameter b, which callers going through
	// the closed type U can never provide.
	bad2: U & (func(a: int, b: int) -> int: a+b) @test(err, code=eval, contains="parameter b of function not allowed by closed function type")

	// An extra optional parameter is allowed even for a closed type.
	ok3:  U & (func(a: int, b?: int) -> int: a)
	ok3x: ok3(1) @test(eq, 1)
}

anonymous: {
	// An anonymous type parameter matches the value's positional parameter
	// in the same position, and its constraint applies to calls.
	A:  func(int, ...) -> int
	h:  A & (func(n: int) -> int: n + 1)
	hx: h(1) @test(eq, 2)
	he: h("x") @test(err, code=eval, contains="conflicting values")

	// A named type parameter matches by label only; an anonymous value
	// parameter cannot be addressed by name.
	B:    func(m: int) -> int
	bBad: B & (func(int) -> int: 1) @test(err, code=eval, contains="parameter m of function type not allowed by closed function")

	// A named positional parameter of the value may be covered by an
	// anonymous parameter of a closed type in the same position.
	C:   func(int) -> int
	cOk: C & (func(n: int) -> int: n)
	cx:  cOk(5) @test(eq, 5)

	// A type constraint matched to an anonymous positional parameter of
	// the value is enforced per call: the argument is bound to a synthetic
	// activation arc even though the body cannot reference it.
	D:    func(<10, ...) -> int
	d:    D & (func(int) -> int: 1)
	dOk:  d(5) @test(eq, 1)
	dOob: d(15) @test(err, code=eval, contains="invalid value 15 (out of bound <10)")

	// The value's own constraint on an anonymous parameter is enforced on
	// its argument as well.
	f:    func(int) -> int: 1
	fOk:  f(1) @test(eq, 1)
	fBad: f("x") @test(err, code=eval, contains="conflicting values")

	// Arity errors take precedence: missing and surplus arguments for
	// anonymous parameters are still reported as such.
	few:  f() @test(err, code=eval, contains="not enough arguments in function call")
	many: f(1, 2) @test(err, code=eval, contains="too many positional arguments in function call")
}

meet: {
	// The meet of two open types carries both signatures; the result is
	// open only in the sense that both constituents are open.
	n: (func(a: number, ...) -> number) & (func(a: int, ...) -> int)

	// Calling a type, met or not, remains an error.
	nc: n(1) @test(err, code=eval, contains="cannot call function without implementation")

	// A value unified with the meet is constrained by both signatures.
	v:  n & (func(a: int) -> int: a)
	vx: v(3) @test(eq, 3)

	// Both types' parameter constraints apply on calls: a string conflicts
	// with both, a float only with the int signature.
	w:   n & (func(a: _) -> _: a)
	wx:  w("x") @test(err, code=eval, contains="conflicting values")
	wx2: w(0.5) @test(err, code=eval, contains="conflicting values")

	// Parameters of closed signatures must match by name.
	badName: (func(a: int) -> int) & (func(b: int) -> int) @test(err, code=eval, contains="parameter b of function type not allowed by closed function type")

	// Requiredness must agree between signatures.
	badReq: (func(a!: int) -> int) & (func(a: int, ...) -> int) @test(err, code=eval, contains="parameter a must be required in both")

	// A parameter present in only one signature is allowed if the other
	// signature is open.
	wider:  (func(a: int, ...) -> int) & (func(a: int, b: int, ...) -> int)
	widerV: wider & (func(a: int, b: int, c?: int) -> int: a + b)
	widerX: widerV(1, 2) @test(eq, 3)
}

// An extra parameter is admitted against a closed signature iff it is
// optional (?): it can never be bound by a call through the closed
// signature, but no call needs it either. One rule governs function
// tightening (both directions), function type meets, and subsumption
// (see internal/core/subsume); builtins have no optional markers (see
// builtins.txtar).
optionalExtra: {
	// Tightening: an extra optional parameter of the value against a
	// closed type (also covered by closed.ok3).
	V:   func(a: int) -> number
	v1:  V & (func(a: int, b?: int) -> int: a)
	v1x: v1(1) @test(eq, 1)

	// Tightening: an extra optional parameter of the type against a
	// closed value signature.
	W:   func(a: int, b?: int) -> number
	w1:  W & (func(a: int) -> int: a)
	w1x: w1(1) @test(eq, 1)

	// Tightening: an extra plain parameter remains rejected in both
	// directions (see closed.bad1 and closed.bad2), as does a required
	// one.
	badT: (func(a: int, b: int) -> number) & (func(a: int) -> int: a) @test(err, code=eval, contains="parameter b of function type not allowed by closed function")
	badV: (func(a: int) -> number) & (func(a: int, b: int) -> int: a) @test(err, code=eval, contains="parameter b of function not allowed by closed function type")
	badR: (func(a: int) -> number) & (func(a: int, b!: int) -> int: a) @test(err, code=eval, contains="parameter b of function not allowed by closed function type")

	// Meet: an extra optional parameter of one closed signature is
	// admitted by the other; an extra plain parameter is not.
	m1:   (func(a: int) -> number) & (func(a: int, b?: int) -> int)
	m2:   (func(a: int, b?: int) -> int) & (func(a: int) -> number)
	mBad: (func(a: int) -> number) & (func(a: int, b: int) -> int) @test(err, code=eval, contains="parameter b of function type not allowed by closed function type")

	// A value unified with the meet is checked against, and calls are
	// constrained by, both signatures, regardless of the meet's order.
	m1v:  m1 & (func(a: int) -> int: a)
	m1vx: m1v(1) @test(eq, 1)
	m2v:  m2 & (func(a: int) -> int: a)
	m2vx: m2v(1) @test(eq, 1)

	// Against an open signature, any extra parameter is admitted.
	o1:  (func(a: int, ...) -> number) & (func(a: int, b: int, ...) -> int)
	o1v: o1 & (func(a: int, b: int, c?: int) -> int: a + b)
	o1x: o1v(1, 2) @test(eq, 3)
	o2:  (func(a: int, ...) -> number) & (func(a: int, b?: int) -> int: a)
	o2x: o2(1) @test(eq, 1)
}

values: {
	f: func(a: int) -> int: a
	g: func(a: int) -> int: a

	// Distinct function values still conflict, as before.
	conflict: f & g @test(err, code=eval, contains="conflicting values")

	// A function value unifies with itself.
	same:  f & f
	sameX: same(1) @test(eq, 1)

	// Values tightened by the same type are equal and unify; the type
	// constraint is recorded once.
	T:     func(a: int, ...) -> number
	t1:    T & f
	t2:    T & f
	both:  t1 & t2
	bothX: both(1) @test(eq, 1)

	// Equality of tightened values also holds for disjunction
	// deduplication: t1 | t2 collapses to a single callable value.
	pick:  t1 | t2
	pickX: pick(1) @test(eq, 1)

	// The order in which types tighten a value does not matter: the
	// recorded type constraints compare as a set, so both orders unify
	// and deduplicate in a disjunction.
	U:      func(a: number, ...) -> number
	o1:     T & U & f
	o2:     U & T & f
	both2:  o1 & o2
	both2X: both2(1) @test(eq, 1)
	pick2:  o1 | o2
	pick2X: pick2(1) @test(eq, 1)
}

// Tightening must preserve all structural cycle semantics: the cycle
// anchor and call-site identity remain those of the function value being
// called.
cycles: {
	T: func(n: int, ...) -> number

	recursive: {
		fn:  T & (func(n: int) -> int: fn(n))
		out: fn(1) @test(err, code=structural_cycle, contains="structural cycle")
	}

	nesting: {
		sum:   func(a: int, b: int) -> int: a + b
		twice: T & (func(n: int) -> int: sum(n, n))
		out:   twice(twice(2)) @test(eq, 8)
		deep:  twice(twice(twice(2))) @test(eq, 16)
	}
}

// Tightening narrows the values a call accepts and returns, beyond mere
// kind checks: bounds and struct restrictions of the type apply to every
// call of the tightened value.
narrow: {
	// The type narrows the parameter to a bound, resolved in the type's
	// own scope.
	lim: 10
	T:   func(n: <lim, ...) -> number
	f:   T & (func(n: int) -> int: n + 1)

	ok:  f(5) @test(eq, 6)
	oob: f(15) @test(err, code=eval, contains="invalid value 15 (out of bound <10)")

	// The type narrows the result: the value's result must satisfy it per
	// call.
	R:  func(n: int, ...) -> <100
	sq: R & (func(n: int) -> int: n * n)

	small: sq(5) @test(eq, 25)
	big:   sq(20) @test(err, code=eval, contains="invalid value 400 (out of bound <100)")

	// The type restricts a struct parameter: a required field with a
	// narrower type than the value itself demands.
	S:    func(cfg: {name: string, port: >0 & <65536}, ...) -> string
	srv:  S & (func(cfg: {...}) -> string: cfg.name)

	good: srv({name: "db", port: 5432}) @test(eq, "db")
	badField: srv({name: 42, port: 80}) @test(err, code=eval, contains="conflicting values string and 42")
	badPort:  srv({name: "db", port: 0}) @test(err, code=eval, contains="invalid value 0 (out of bound >0)")

	// Narrowing stacks across a chain of tightenings.
	N:  func(n: >=0, ...) -> number
	M:  func(n: <10, ...) -> number
	g:  N & M & (func(n: int) -> int: n)

	mid: g(5) @test(eq, 5)
	neg: g(-1) @test(err, code=eval, contains="invalid value -1 (out of bound >=0)")
	hi:  g(11) @test(err, code=eval, contains="invalid value 11 (out of bound <10)")
}
