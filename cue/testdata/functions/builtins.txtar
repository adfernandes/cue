# Tests that builtins satisfy function types: unifying a builtin with a
# compatible function type succeeds and yields the builtin, with the type's
# parameter and result constraints additionally enforced on every call.
# A builtin binds its arguments by position, so a type's parameters match the
# builtin's by position. Naming them is allowed: a plain parameter is both
# named and positional, so it gives the otherwise unnamed raw slot a contract
# label without changing the builtin's positional ABI. Only a parameter that
# can be passed by label alone —
# marked required (a!) or optional (a?) — cannot be satisfied by a builtin.
# Statically checked at unification time are parameter matching, arity, and
# kind-level compatibility where the constraint is literally a basic type;
# all other constraints surface when the tightened builtin is called.
-- in.cue --
@experiment(functions)

import "strings"

tighten: {
	T:  func(string, ...) -> string
	up: T & strings.ToUpper
	x:  up("hi") @test(eq, "HI")

	// Order of unification does not matter.
	upRev: strings.ToUpper & T
	xRev:  upRev("hi") @test(eq, "HI")

	// An open type with no parameters is satisfied by any builtin.
	O:  func(...) -> string
	o:  O & strings.ToUpper
	ox: o("hi") @test(eq, "HI")

	// A named parameter is positional as well, so it matches the builtin's
	// raw parameter by position and supplies its contract label.
	named: (func(s: string) -> string) & strings.ToUpper
	nx:    named("hi") @test(eq, "HI")
}

static: {
	// Arity is checked statically in both directions: the type must not
	// declare more positional parameters than the builtin accepts, and a
	// closed type must cover every defaultless parameter of the builtin.
	tooMany: (func(string, string, ...) -> string) & strings.ToUpper @test(err, code=eval, contains="function type has more positional parameters than builtin strings.ToUpper")
	tooFew:  (func() -> string) & strings.ToUpper @test(err, code=eval, contains="builtin strings.ToUpper has more parameters than closed function type")

	// Kind-level conflicts that are decidable from the compiled signature
	// (the constraint is literally a basic type) are rejected statically.
	badParam:  (func(int, ...) -> string) & strings.ToUpper @test(err, code=eval, contains="parameter 1 of function type has kind int, conflicting with kind string of builtin strings.ToUpper")
	badResult: (func(string, ...) -> int) & strings.ToUpper @test(err, code=eval, contains="result of function type has kind int, conflicting with result kind string of builtin strings.ToUpper")

	// A builtin never unifies with a proper function value.
	f:        func(a: string) -> string: a
	conflict: f & strings.ToUpper @test(err, code=eval, contains="conflicting values")
}

// Constraints that are not decidable from the signatures alone are enforced
// dynamically, on every call through the tightened builtin.
dynamic: {
	// The type narrows the parameter to a bound.
	P:  func(<="m", ...) -> string
	up: P & strings.ToUpper

	ok:  up("hi") @test(eq, "HI")
	oob: up("zz") @test(err, code=eval, contains="out of bound")

	// The type narrows the result.
	R:   func(string, ...) -> "HI"
	up2: R & strings.ToUpper

	good: up2("hi") @test(eq, "HI")
	bad:  up2("no") @test(err, code=eval, contains="conflicting values")

	// Narrowing stacks across a chain of tightenings.
	A:   func(string, ...) -> string
	B:   func(<="m", ...) -> _
	up3: A & B & strings.ToUpper

	mid: up3("hi") @test(eq, "HI")
	hi:  up3("zz") @test(err, code=eval, contains="out of bound")
}

// An extra parameter is admitted against a closed signature iff it is
// optional. For builtins this cuts both ways: an extra optional named
// parameter of the type can never be bound by a call through the builtin,
// but no call needs it either; the builtin's own parameters carry no
// optional markers, so only a parameter with a default may exceed a closed
// type's count (defaults of builtins are static metadata, unlike function
// value defaults, which are dynamic and never probed).
optionalExtra: {
	O:  func(string, sep?: string) -> string
	up: O & strings.ToUpper
	x:  up("hi") @test(eq, "HI")

	// A required parameter is rejected: unlike a plain named parameter
	// (see tighten.named), it can only be passed by label, which a call
	// through a builtin cannot do.
	bad: (func(string, sep!: string) -> string) & strings.ToUpper @test(err, code=eval, contains="parameter sep of function type not allowed by builtin strings.ToUpper: it can only be passed by label, and a builtin takes its arguments positionally")
}

// Tightened builtins are equal when derived from the same builtin with the
// same type constraints: disjunction deduplication collapses them to a
// single callable value.
disjunction: {
	T:    func(string, ...) -> string
	t1:   T & strings.ToUpper
	t2:   T & strings.ToUpper
	pick: t1 | t2
	x:    pick("hi") @test(eq, "HI")
}

// Partial application of builtins is not supported: a call with a trailing
// "..." reports a clear error instead of silently dropping the "..." (len)
// or morphing into a validator (strings.Contains).
partial: {
	contains: strings.Contains("abcd", ...) @test(err, code=eval, contains="partial application of builtin")
	length:   len([1, 2], ...) @test(err, code=eval, contains="partial application of builtin")
}

// len is polymorphic over strings, bytes, lists, and structs; its kind-level
// signature is compatible with a type over any of these.
polymorphic: {
	L: func(_, ...) -> int
	l: L & len

	str:  l("foo") @test(eq, 3)
	list: l([1, 2]) @test(eq, 2)

	// The type may narrow the accepted arguments to a subset of the kinds
	// the builtin accepts; the narrowing applies per call.
	S:    func(string, ...) -> int
	ls:   S & len
	sOk:  ls("foo") @test(eq, 3)
	sBad: ls([1, 2]) @test(err, code=eval, contains="conflicting values")

	// A statically incompatible result kind is rejected.
	bad: (func(_, ...) -> string) & len @test(err, code=eval, contains="result of function type has kind string, conflicting with result kind int of builtin len")
}
