// Issue #729
-- in.cue --
ifScalar: {
	_#cond: true

	if _#cond {5}
	@test(eq, {
		5
		_#cond: true
	})
}

ifScalarConflict: {
	_#cond: true

	if _#cond {5}

	"soo"
	@test(err, code=eval, contains="conflicting values", args=["soo", 5, string, int], pos=[3:13, 5:2],
		hint="the struct literal positions dropped out at v0.18.0: an embedded struct or comprehension conjunct is no longer split into a node of its own, so its literal contributes no position of its own")
}

ifScalarNested: {
	_#cond: true

	if _#cond {{{5}}}

	@test(eq, {5, _#cond: true})
}
-- out/errors.txt --
[eval] ifScalarConflict: conflicting values "soo" and 5 (mismatched types string and int):
    ./in.cue:14:13
    ./in.cue:16:2
