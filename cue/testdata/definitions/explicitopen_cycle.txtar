# Mutually recursive definitions embedding each other must not overflow the
# stack under the strict embedding of v0.18.0. Mirrors issue4006 in
# typocheck.txtar, which is pinned to the older semantics.
#
# Under the strict embedding of v0.18.0 #B is a closed embedding in #A, but #B
# is just {#A} and so admits everything #A admits. The cycle therefore resolves
# to {fieldA: string} everywhere, as it did before v0.18.0.
-- in.cue --
issue4006: {
	#A: {
		#B
		fieldA: string
	}
	#B: {#A}
	#C: #A & {}
	out: #C & #B

	@test(eq, {
		#A: {fieldA: string}
		#B: {fieldA: string}
		#C: {fieldA: string}
		out: {fieldA: string}
	})
}
